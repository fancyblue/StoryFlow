{
  "name": "storyflow",
  "private": true,
  "type": "module",
  "scripts": {
    "test:static": "node scripts/check-static.mjs",
    "test:palette": "node scripts/palette-contract.mjs",
    "test:css": "node scripts/dead-selectors.mjs --check && node scripts/dead-declarations.mjs --check",
    "test:browser": "playwright test --config playwright.config.mjs",
    "test": "npm run test:static && npm run test:palette && npm run test:css && npm run test:assets && npm run test:browser",
    "test:assets": "node scripts/bump-assets.mjs --check",
    "bump:assets": "node scripts/bump-assets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
